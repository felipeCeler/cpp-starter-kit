{
  "version": 8,
  "configurePresets": [
    {
      "name": "abstract-gcc-x64",
      "hidden": true,
       "environment": {
        "CFLAGS": "-m64",
        "CXXFLAGS": "-m64",
        "LDFLAGS": "-m64"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
      
    }
  ]
}